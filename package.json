{
  "name": "open-cards",
  "private": true,
  "version": "0.1.5",
  "packageManager": "pnpm@12.3.4",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:android": "tsc -b && cross-env VITE_BASE=/ vite build && pnpm exec cap sync android",
    "icons": "node scripts/generate-icons.mjs",
    "cap:sync": "pnpm exec cap sync android",
    "cap:open": "pnpm exec cap open android",
    "android:assemble": "pnpm build:android && pnpm android:gradle",
    "android:gradle": "node -e \"const {spawnSync}=require('node:child_process'); const win=process.platform==='win32'; const cmd=win?'gradlew.bat':'./gradlew'; const r=spawnSync(cmd,['assembleDebug','--no-daemon'],{cwd:'android',stdio:'inherit',shell:win}); process.exit(r.status??1)\"",
    "lint": "oxlint",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@capacitor/app": "^8.1.2",
    "@capacitor/core": "^8.5.3",
    "@capacitor/status-bar": "^8.0.4",
    "@codemirror/lang-java": "^6.0.2",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-php": "^6.0.2",
    "@codemirror/lang-python": "^6.2.1",
    "@codemirror/lang-sql": "^6.10.0",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@gsap/react": "^2.1.2",
    "@uiw/react-codemirror": "^4.25.12",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "dexie": "^4.4.6",
    "gsap": "^3.15.0",
    "katex": "^0.19.0",
    "mathlive": "^0.111.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router-dom": "^7.18.4",
    "workbox-window": "^7.4.1"
  },
  "devDependencies": {
    "@capacitor/android": "^8.5.3",
    "@capacitor/cli": "^8.5.3",
    "@types/katex": "^0.16.8",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "cross-env": "^10.1.0",
    "jsdom": "^30.1.2",
    "oxlint": "^1.87.0",
    "shadcn": "^4.21.4",
    "sharp": "^0.35.5",
    "typescript": "~6.0.3",
    "vite": "^8.3.4",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.0.4"
  }
}
