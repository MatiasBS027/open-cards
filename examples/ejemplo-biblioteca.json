      "cards": [
        {
          "id": "0b7d9c34-52e1-4c8a-8d77-1a2f3e4d5c6b",
          "front": [
            { "type": "text", "content": "¿Qué dice la regla de L'Hôpital?" }
          ],
          "back": [
            {
              "type": "text",
              "content": "Si $\\lim_{x\\to a} f(x) = \\lim_{x\\to a} g(x) = 0$ (o ambos tienden a $\\pm\\infty$), y se cumplen las condiciones del teorema, entonces:"
            },
            {
              "type": "math",
              "content": "\\lim_{x\\to a}\\frac{f(x)}{g(x)} = \\lim_{x\\to a}\\frac{f'(x)}{g'(x)}"
            }
          ],
          "state": "understood"
        },
        {
          "id": "c4e8a1d2-7f30-4b9e-a6c5-3d2e1f0a9b8c",
          "front": [
            { "type": "text", "content": "¿Cuál es la derivada de $\\sin x$?" }
          ],
          "back": [
            { "type": "math", "content": "\\frac{d}{dx}\\sin x = \\cos x" }
          ]
        }
      ]
    },
    {
