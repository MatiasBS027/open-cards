{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Open Cards v1",
  "description": "Formato de importación/exportación de Open Cards. Siempre contiene un arreglo `decks`; el orden del arreglo `cards` es el orden de las tarjetas. Este esquema valida la forma; el dominio de la app exige además contenido no vacío (trim) en frente/reverso y fórmulas renderizables.",
  "type": "object",
  "required": ["format", "version", "decks"],
  "properties": {
    "format": { "const": "open-cards" },
    "version": { "const": 1 },
    "exportedAt": { "type": "string", "format": "date-time" },
    "decks": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/deck" }
    }
  },
  "$defs": {
    "tagName": {
      "type": "string",
      "minLength": 1,
      "maxLength": 50
    },
    "state": {
      "enum": ["unseen", "seen", "understood", "needs_review"]
    },
    "textBlock": {
      "type": "object",
      "required": ["type", "content"],
      "properties": {
        "type": { "const": "text" },
        "content": { "type": "string" }
      }
    },
    "mathBlock": {
      "type": "object",
      "required": ["type", "content"],
      "properties": {
        "type": { "const": "math" },
        "content": { "type": "string" }
      }
    },
    "codeBlock": {
      "type": "object",
      "required": ["type", "language", "content"],
      "properties": {
        "type": { "const": "code" },
        "language": { "type": "string", "minLength": 1 },
        "content": { "type": "string" }
      }
    },
    "block": {
      "oneOf": [
        { "$ref": "#/$defs/textBlock" },
        { "$ref": "#/$defs/mathBlock" },
        { "$ref": "#/$defs/codeBlock" }
      ]
    },
    "blocks": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/block" }
    },
    "card": {
      "type": "object",
      "required": ["front", "back"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "front": { "$ref": "#/$defs/blocks" },
        "back": { "$ref": "#/$defs/blocks" },
        "state": { "$ref": "#/$defs/state", "default": "unseen" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      }
    },
    "deck": {
      "type": "object",
      "required": ["name", "cards"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "name": { "type": "string", "minLength": 1, "maxLength": 120 },
        "description": { "type": "string", "maxLength": 2000 },
        "tags": {
          "type": "array",
          "items": { "$ref": "#/$defs/tagName" },
          "default": []
        },
        "cards": {
          "type": "array",
          "maxItems": 1000,
          "items": { "$ref": "#/$defs/card" }
        },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      }
    }
  }
}
